{
  "name": "sqsadmin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001 --strictPort",
    "dev:local": "env-cmd -f .env.local vite dev --port 3001 --strictPort",
    "dev:aws": "env-cmd -f .env.aws vite dev --port 3001 --strictPort",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@aws-sdk/client-sqs": "^3.799.0",
    "@aws-sdk/types": "^3.775.0",
    "@headlessui/react": "^2.2.10",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-query-devtools": "^5.100.1",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.11",
    "@tanstack/react-start": "^1.167.42",
    "@tanstack/router-plugin": "^1.132.0",
    "@vitejs/plugin-react": "^6.0.1",
    "ace-builds": "^1.40.1",
    "js-yaml": "^4.1.1",
    "nitro": "^3.0.260415-beta",
    "react": "19.2.5",
    "react-ace": "^14.0.1",
    "react-dom": "19.2.5",
    "react-json-view-lite": "^2.4.1",
    "start-authjs": "^1.0.2",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/devtools-vite": "^0.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "env-cmd": "^10.1.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "5.9.3"
  }
}
