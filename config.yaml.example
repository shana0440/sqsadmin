systems:
  demo:
    # Queues accessible by the demo system
    - "demo-greeting-*"

environment:
  # Queues grouped by environment for UI filtering
  uat:
    - "uat-*"
  production:
    - "production-*"

system_users:
  # Admin has access to all queues
  admin:
    # admin user emails
    - admin@example.com
  demo:
    # Demo system user emails; restricted to queues declared in the demo system
    - demo@example.com